# ─── LLM Providers ───────────────────────────────────────────
MISTRAL_API_KEY=your-mistral-api-key
NVIDIA_API_KEY=your-nvidia-api-key
DEFAULT_PROVIDER=nvidia

# Models (override defaults)
MISTRAL_STRONG_MODEL=mistral-large-latest
MISTRAL_CHEAP_MODEL=mistral-small-latest
NVIDIA_STRONG_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_CHEAP_MODEL=nvidia/nemotron-3.5-bolt-e4b

# ─── Security ────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# ─── Telegram Notifications ─────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ─── App Settings ────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/job_agent.db
BROWSER_PROFILE_DIR=./data/browser_profile
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=3000
